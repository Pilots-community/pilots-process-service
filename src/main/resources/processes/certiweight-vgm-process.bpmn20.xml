            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="BPMNShape_sendTruckerAnnounced" bpmnElement="sendTruckerAnnounced">
                <dc:Bounds x="754" y="160" width="100" height="80"/>
                <bpmndi:BPMNLabel/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="BPMNShape_throwTruckerAnnounced" bpmnElement="throwTruckerAnnounced">
                <dc:Bounds x="904" y="182" width="36" height="36"/>
                <bpmndi:BPMNLabel><dc:Bounds x="880" y="225" width="84" height="27"/></bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="BPMNShape_waitToSendMeasurement" bpmnElement="waitToSendMeasurement">
                <dc:Bounds x="990" y="160" width="100" height="80"/>
