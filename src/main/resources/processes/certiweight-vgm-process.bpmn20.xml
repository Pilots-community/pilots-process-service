                <bpmndi:BPMNLabel/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="BPMNShape_throwMeasurementCreated" bpmnElement="throwMeasurementCreated">
                <dc:Bounds x="1290" y="182" width="36" height="36"/>
                <bpmndi:BPMNLabel><dc:Bounds x="1266" y="225" width="84" height="27"/></bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="BPMNShape_waitPurchaseVGM" bpmnElement="waitPurchaseVGM">
                <dc:Bounds x="1376" y="182" width="36" height="36"/>
                <bpmndi:BPMNLabel><dc:Bounds x="1352" y="225" width="84" height="27"/></bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="BPMNShape_taskProcessPayment" bpmnElement="taskProcessPayment">
                <dc:Bounds x="1462" y="160" width="100" height="80"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="BPMNShape_taskCreateCertificate" bpmnElement="taskCreateCertificate">
                <dc:Bounds x="1612" y="160" width="100" height="80"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="BPMNShape_sendVGMPurchased" bpmnElement="sendVGMPurchased">
                <dc:Bounds x="1762" y="160" width="100" height="80"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="BPMNShape_throwVGMPurchased" bpmnElement="throwVGMPurchased">
                <dc:Bounds x="1912" y="182" width="36" height="36"/>
                <bpmndi:BPMNLabel><dc:Bounds x="1888" y="225" width="84" height="27"/></bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="BPMNShape_endEvent" bpmnElement="endEvent">
                <dc:Bounds x="1998" y="182" width="36" height="36"/>
                <bpmndi:BPMNLabel><dc:Bounds x="1976" y="225" width="80" height="14"/></bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

