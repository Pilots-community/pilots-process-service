<?xml version="1.0" encoding="UTF-8"?>
<!--
  Certiweight VGM Process  (provider / weighing company)
  Process ID: certiweightVGMProcess

  Flow:
    Start
      -> ReceiveTask           "Wait to Send Order"       ERP PATCHes to unblock
      -> ServiceTask           "Send Order Created"       internal ERP call (httpPostDelegate)
      -> IntermediateThrowEvent "Order Created"           contracted event, notifies Shipper via EDC
      -> ReceiveTask           "Wait to Send Trucker"     ERP PATCHes to unblock
      -> ServiceTask           "Send Trucker Announced"   internal ERP call
      -> IntermediateThrowEvent "Trucker Announced"       contracted event, notifies Shipper via EDC
      -> ReceiveTask           "Wait to Send Measurement" ERP PATCHes to unblock
      -> ServiceTask           "Send Measurement Created" internal ERP call
      -> IntermediateThrowEvent "Measurement Created"     contracted event, notifies Shipper via EDC
      -> IntermediateCatchEvent "Wait for Payment"        Certiweight ERP PATCHes directly
      -> ServiceTask           "Process Payment"          internal (no-op placeholder)
      -> ServiceTask           "Create Certificate"       internal (no-op placeholder)
      -> ServiceTask           "Send VGM Purchased"       internal ERP call
      -> IntermediateThrowEvent "VGM Purchased"           contracted event, notifies Shipper via EDC
    End

  Throw events carry the contracted interface: edcNotifyDelegate fires as an execution
  listener, sending the agreed state and parameters to the Shipper through the EDC data-plane.
  Tasks between events are internal to Certiweight and can change without affecting the Shipper.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="https://example.com/lod/vgm">

    <message id="msgPurchaseVGM" name="PurchaseVGM"/>

    <process id="certiweightVGMProcess"
             name="Certiweight LOD VGM Process"
             isExecutable="true">

        <startEvent id="startEvent" name="Start VGM Workflow"/>
        <sequenceFlow id="flow0" sourceRef="startEvent" targetRef="waitToSendOrder"/>

        <receiveTask id="waitToSendOrder" name="Wait to Send Order"/>
        <sequenceFlow id="flow1" sourceRef="waitToSendOrder" targetRef="sendOrderCreated"/>

        <serviceTask id="sendOrderCreated"
                     name="Send Order Created"
                     flowable:delegateExpression="${httpPostDelegate}">
            <extensionElements>
                <flowable:field name="url"     expression="${internalApiUrl}"/>
                <flowable:field name="payload" expression="${payloadData}"/>
            </extensionElements>
        </serviceTask>
        <sequenceFlow id="flow2" sourceRef="sendOrderCreated" targetRef="throwOrderCreated"/>

        <intermediateThrowEvent id="throwOrderCreated" name="Order Created">
            <extensionElements>
                <flowable:executionListener event="start"
                        delegateExpression="${edcNotifyDelegate}">
                    <flowable:field name="targetInstanceId" expression="${shipperInstanceId}"/>
                    <flowable:field name="notifyState"      stringValue="ORDER_CONFIRMED"/>
                    <flowable:field name="notifyParams"     expression="${shipperNotifyParams}"/>
                </flowable:executionListener>
            </extensionElements>
        </intermediateThrowEvent>
        <sequenceFlow id="flow2b" sourceRef="throwOrderCreated" targetRef="waitToSendTrucker"/>

        <receiveTask id="waitToSendTrucker" name="Wait to Send Trucker"/>
        <sequenceFlow id="flow3" sourceRef="waitToSendTrucker" targetRef="sendTruckerAnnounced"/>

        <serviceTask id="sendTruckerAnnounced"
                     name="Send Trucker Announced"
                     flowable:delegateExpression="${httpPostDelegate}">
            <extensionElements>
                <flowable:field name="url"     expression="${truckerApiUrl}"/>
                <flowable:field name="payload" expression="${truckerPayload}"/>
            </extensionElements>
        </serviceTask>
        <sequenceFlow id="flow4" sourceRef="sendTruckerAnnounced" targetRef="throwTruckerAnnounced"/>

        <intermediateThrowEvent id="throwTruckerAnnounced" name="Trucker Announced">
            <extensionElements>
                <flowable:executionListener event="start"
                        delegateExpression="${edcNotifyDelegate}">
                    <flowable:field name="targetInstanceId" expression="${shipperInstanceId}"/>
                    <flowable:field name="notifyState"      stringValue="TRUCKER_ANNOUNCED"/>
                    <flowable:field name="notifyParams"     expression="${shipperNotifyParams}"/>
                </flowable:executionListener>
            </extensionElements>
        </intermediateThrowEvent>
        <sequenceFlow id="flow4b" sourceRef="throwTruckerAnnounced" targetRef="waitToSendMeasurement"/>

        <receiveTask id="waitToSendMeasurement" name="Wait to Send Measurement"/>
        <sequenceFlow id="flow5" sourceRef="waitToSendMeasurement" targetRef="sendMeasurementCreated"/>

        <serviceTask id="sendMeasurementCreated"
                     name="Send Measurement Created"
                     flowable:delegateExpression="${httpPostDelegate}">
            <extensionElements>
                <flowable:field name="url"     expression="${measurementApiUrl}"/>
                <flowable:field name="payload" expression="${measurementPayload}"/>
            </extensionElements>
        </serviceTask>
        <sequenceFlow id="flow6" sourceRef="sendMeasurementCreated" targetRef="throwMeasurementCreated"/>

        <intermediateThrowEvent id="throwMeasurementCreated" name="Measurement Created">
            <extensionElements>
                <flowable:executionListener event="start"
                        delegateExpression="${edcNotifyDelegate}">
                    <flowable:field name="targetInstanceId" expression="${shipperInstanceId}"/>
                    <flowable:field name="notifyState"      stringValue="MEASUREMENT_RECEIVED"/>
                    <flowable:field name="notifyParams"     expression="${shipperNotifyParams}"/>
                </flowable:executionListener>
            </extensionElements>
        </intermediateThrowEvent>
        <sequenceFlow id="flow6b" sourceRef="throwMeasurementCreated" targetRef="waitPurchaseVGM"/>

        <intermediateCatchEvent id="waitPurchaseVGM" name="Wait for Payment Processed">
            <messageEventDefinition messageRef="msgPurchaseVGM"/>
        </intermediateCatchEvent>
        <sequenceFlow id="flow7" sourceRef="waitPurchaseVGM" targetRef="taskProcessPayment"/>

        <serviceTask id="taskProcessPayment"
                     name="Process Payment"
                     flowable:expression="${true}"/>
        <sequenceFlow id="flow8" sourceRef="taskProcessPayment" targetRef="taskCreateCertificate"/>

        <serviceTask id="taskCreateCertificate"
                     name="Create Certificate"
                     flowable:expression="${true}"/>
        <sequenceFlow id="flow9" sourceRef="taskCreateCertificate" targetRef="sendVGMPurchased"/>

        <serviceTask id="sendVGMPurchased"
                     name="Send VGM Purchased"
                     flowable:delegateExpression="${httpPostDelegate}">
            <extensionElements>
                <flowable:field name="url"     expression="${internalApiUrl}"/>
                <flowable:field name="payload" expression="${payloadData}"/>
            </extensionElements>
        </serviceTask>
        <sequenceFlow id="flow10" sourceRef="sendVGMPurchased" targetRef="throwVGMPurchased"/>

        <intermediateThrowEvent id="throwVGMPurchased" name="VGM Purchased">
            <extensionElements>
                <flowable:executionListener event="start"
                        delegateExpression="${edcNotifyDelegate}">
                    <flowable:field name="targetInstanceId" expression="${shipperInstanceId}"/>
                    <flowable:field name="notifyState"      stringValue="VGM_PURCHASED"/>
                    <flowable:field name="notifyParams"     expression="${shipperNotifyParams}"/>
                </flowable:executionListener>
            </extensionElements>
        </intermediateThrowEvent>
        <sequenceFlow id="flow11" sourceRef="throwVGMPurchased" targetRef="endEvent"/>

        <endEvent id="endEvent" name="Workflow Complete"/>

    </process>

    <bpmndi:BPMNDiagram id="BPMNDiagram_certiweightVGMProcess">
        <bpmndi:BPMNPlane id="BPMNPlane_certiweightVGMProcess" bpmnElement="certiweightVGMProcess">

            <bpmndi:BPMNShape id="BPMNShape_startEvent" bpmnElement="startEvent">
                <dc:Bounds x="100" y="182" width="36" height="36"/>
                <bpmndi:BPMNLabel><dc:Bounds x="76" y="225" width="84" height="27"/></bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="BPMNShape_waitToSendOrder" bpmnElement="waitToSendOrder">
                <dc:Bounds x="186" y="160" width="100" height="80"/>
                <bpmndi:BPMNLabel/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="BPMNShape_sendOrderCreated" bpmnElement="sendOrderCreated">
                <dc:Bounds x="336" y="160" width="100" height="80"/>
