<?xml version="1.0" encoding="UTF-8"?>
<!--
  Certiweight VGM Process  (provider / weighing company)
  Process ID: certiweightVGMProcess

  Flow:
    Start
      -> ReceiveTask  "Wait to Send Order"            ERP PATCHes -> triggers sendOrderCreated
      -> ServiceTask  "Send Order Created"             httpPostDelegate with field injection
      -> ServiceTask  "Notify Shipper Order Created"   edcNotifyDelegate (no-op if no EDC token)
      -> ReceiveTask  "Wait to Send Trucker"           ERP PATCHes -> triggers sendTruckerAnnounced
      -> ServiceTask  "Send Trucker Announced"         httpPostDelegate with field injection
      -> ServiceTask  "Notify Shipper Trucker Announced" edcNotifyDelegate
      -> ReceiveTask  "Wait to Send Measurement"       ERP PATCHes -> triggers sendMeasurementCreated
      -> ServiceTask  "Send Measurement Created"       httpPostDelegate with field injection
      -> ServiceTask  "Notify Shipper Measurement Created" edcNotifyDelegate
      -> CatchEvent   "Wait for Payment Processed"     Certiweight ERP PATCHes directly
      -> ServiceTask  "Process Payment"                no-op placeholder
      -> ServiceTask  "Create Certificate"             no-op placeholder
      -> ServiceTask  "Send VGM Purchased"             httpPostDelegate with field injection
      -> ServiceTask  "Notify Shipper VGM Purchased"   edcNotifyDelegate
    End
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="https://example.com/lod/vgm">

    <message id="msgPurchaseVGM" name="PurchaseVGM"/>

    <process id="certiweightVGMProcess"
             name="Certiweight LOD VGM Process"
             isExecutable="true">

        <startEvent id="startEvent" name="Start VGM Workflow"/>
        <sequenceFlow id="flow0" sourceRef="startEvent" targetRef="waitToSendOrder"/>

        <!-- ERP provides order data via PATCH; this receive task unblocks sendOrderCreated -->
        <receiveTask id="waitToSendOrder" name="Wait to Send Order"/>
        <sequenceFlow id="flow1" sourceRef="waitToSendOrder" targetRef="sendOrderCreated"/>

        <serviceTask id="sendOrderCreated"
                     name="Send Order Created"
                     flowable:delegateExpression="${httpPostDelegate}">
            <extensionElements>
                <flowable:field name="url"     expression="${internalApiUrl}"/>
                <flowable:field name="payload" expression="${payloadData}"/>
            </extensionElements>
        </serviceTask>
        <sequenceFlow id="flow2" sourceRef="sendOrderCreated" targetRef="notifyShipperOrderCreated"/>

        <serviceTask id="notifyShipperOrderCreated"
                     name="Notify Shipper Order Created"
                     flowable:delegateExpression="${edcNotifyDelegate}">
            <extensionElements>
                <flowable:field name="targetInstanceId" expression="${shipperInstanceId}"/>
                <flowable:field name="notifyState"      stringValue="ORDER_CONFIRMED"/>
                <flowable:field name="notifyParams"     expression="${shipperNotifyParams}"/>
            </extensionElements>
        </serviceTask>
        <sequenceFlow id="flow2b" sourceRef="notifyShipperOrderCreated" targetRef="waitToSendTrucker"/>

        <!-- ERP provides trucker data via PATCH; this receive task unblocks sendTruckerAnnounced -->
        <receiveTask id="waitToSendTrucker" name="Wait to Send Trucker"/>
        <sequenceFlow id="flow3" sourceRef="waitToSendTrucker" targetRef="sendTruckerAnnounced"/>

        <serviceTask id="sendTruckerAnnounced"
                     name="Send Trucker Announced"
                     flowable:delegateExpression="${httpPostDelegate}">
            <extensionElements>
                <flowable:field name="url"     expression="${truckerApiUrl}"/>
                <flowable:field name="payload" expression="${truckerPayload}"/>
            </extensionElements>
        </serviceTask>
        <sequenceFlow id="flow4" sourceRef="sendTruckerAnnounced" targetRef="notifyShipperTruckerAnnounced"/>

        <serviceTask id="notifyShipperTruckerAnnounced"
                     name="Notify Shipper Trucker Announced"
                     flowable:delegateExpression="${edcNotifyDelegate}">
            <extensionElements>
                <flowable:field name="targetInstanceId" expression="${shipperInstanceId}"/>
                <flowable:field name="notifyState"      stringValue="TRUCKER_ANNOUNCED"/>
                <flowable:field name="notifyParams"     expression="${shipperNotifyParams}"/>
            </extensionElements>
        </serviceTask>
        <sequenceFlow id="flow4b" sourceRef="notifyShipperTruckerAnnounced" targetRef="waitToSendMeasurement"/>

        <!-- ERP provides measurement data via PATCH; this receive task unblocks sendMeasurementCreated -->
        <receiveTask id="waitToSendMeasurement" name="Wait to Send Measurement"/>
        <sequenceFlow id="flow5" sourceRef="waitToSendMeasurement" targetRef="sendMeasurementCreated"/>

        <serviceTask id="sendMeasurementCreated"
                     name="Send Measurement Created"
                     flowable:delegateExpression="${httpPostDelegate}">
            <extensionElements>
                <flowable:field name="url"     expression="${measurementApiUrl}"/>
                <flowable:field name="payload" expression="${measurementPayload}"/>
            </extensionElements>
        </serviceTask>
        <sequenceFlow id="flow6" sourceRef="sendMeasurementCreated" targetRef="notifyShipperMeasurementCreated"/>

        <serviceTask id="notifyShipperMeasurementCreated"
                     name="Notify Shipper Measurement Created"
                     flowable:delegateExpression="${edcNotifyDelegate}">
            <extensionElements>
                <flowable:field name="targetInstanceId" expression="${shipperInstanceId}"/>
                <flowable:field name="notifyState"      stringValue="MEASUREMENT_RECEIVED"/>
                <flowable:field name="notifyParams"     expression="${shipperNotifyParams}"/>
            </extensionElements>
        </serviceTask>
        <sequenceFlow id="flow6b" sourceRef="notifyShipperMeasurementCreated" targetRef="waitPurchaseVGM"/>

        <!-- Certiweight ERP PATCHes this after processing payment on its own platform -->
        <intermediateCatchEvent id="waitPurchaseVGM" name="Wait for Payment Processed">
            <messageEventDefinition messageRef="msgPurchaseVGM"/>
        </intermediateCatchEvent>
        <sequenceFlow id="flow7" sourceRef="waitPurchaseVGM" targetRef="taskProcessPayment"/>

        <serviceTask id="taskProcessPayment"
                     name="Process Payment"
                     flowable:expression="${true}"/>
        <sequenceFlow id="flow8" sourceRef="taskProcessPayment" targetRef="taskCreateCertificate"/>

        <serviceTask id="taskCreateCertificate"
                     name="Create Certificate"
                     flowable:expression="${true}"/>
        <sequenceFlow id="flow9" sourceRef="taskCreateCertificate" targetRef="sendVGMPurchased"/>

        <serviceTask id="sendVGMPurchased"
                     name="Send VGM Purchased"
                     flowable:delegateExpression="${httpPostDelegate}">
            <extensionElements>
                <flowable:field name="url"     expression="${internalApiUrl}"/>
                <flowable:field name="payload" expression="${payloadData}"/>
            </extensionElements>
        </serviceTask>
        <sequenceFlow id="flow10" sourceRef="sendVGMPurchased" targetRef="notifyShipperVGMPurchased"/>

        <serviceTask id="notifyShipperVGMPurchased"
                     name="Notify Shipper VGM Purchased"
                     flowable:delegateExpression="${edcNotifyDelegate}">
            <extensionElements>
                <flowable:field name="targetInstanceId" expression="${shipperInstanceId}"/>
                <flowable:field name="notifyState"      stringValue="VGM_PURCHASED"/>
                <flowable:field name="notifyParams"     expression="${shipperNotifyParams}"/>
            </extensionElements>
        </serviceTask>
        <sequenceFlow id="flow11" sourceRef="notifyShipperVGMPurchased" targetRef="endEvent"/>

        <endEvent id="endEvent" name="Workflow Complete"/>

    </process>

    <bpmndi:BPMNDiagram id="BPMNDiagram_certiweightVGMProcess">
        <bpmndi:BPMNPlane id="BPMNPlane_certiweightVGMProcess" bpmnElement="certiweightVGMProcess">

            <bpmndi:BPMNShape id="BPMNShape_startEvent" bpmnElement="startEvent">
                <dc:Bounds x="100" y="182" width="36" height="36"/>
                <bpmndi:BPMNLabel><dc:Bounds x="76" y="225" width="84" height="27"/></bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="BPMNShape_waitToSendOrder" bpmnElement="waitToSendOrder">
                <dc:Bounds x="186" y="160" width="100" height="80"/>
                <bpmndi:BPMNLabel/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="BPMNShape_sendOrderCreated" bpmnElement="sendOrderCreated">
                <dc:Bounds x="336" y="160" width="100" height="80"/>
                <bpmndi:BPMNLabel/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="BPMNShape_notifyShipperOrderCreated" bpmnElement="notifyShipperOrderCreated">
                <dc:Bounds x="486" y="160" width="100" height="80"/>
                <bpmndi:BPMNLabel/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="BPMNShape_waitToSendTrucker" bpmnElement="waitToSendTrucker">
                <dc:Bounds x="636" y="160" width="100" height="80"/>
                <bpmndi:BPMNLabel/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="BPMNShape_sendTruckerAnnounced" bpmnElement="sendTruckerAnnounced">
                <dc:Bounds x="786" y="160" width="100" height="80"/>
                <bpmndi:BPMNLabel/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="BPMNShape_notifyShipperTruckerAnnounced" bpmnElement="notifyShipperTruckerAnnounced">
                <dc:Bounds x="936" y="160" width="100" height="80"/>
                <bpmndi:BPMNLabel/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="BPMNShape_waitToSendMeasurement" bpmnElement="waitToSendMeasurement">
                <dc:Bounds x="1086" y="160" width="100" height="80"/>
                <bpmndi:BPMNLabel/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="BPMNShape_sendMeasurementCreated" bpmnElement="sendMeasurementCreated">
                <dc:Bounds x="1236" y="160" width="100" height="80"/>
                <bpmndi:BPMNLabel/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="BPMNShape_notifyShipperMeasurementCreated" bpmnElement="notifyShipperMeasurementCreated">
                <dc:Bounds x="1386" y="160" width="100" height="80"/>
                <bpmndi:BPMNLabel/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="BPMNShape_waitPurchaseVGM" bpmnElement="waitPurchaseVGM">
                <dc:Bounds x="1536" y="182" width="36" height="36"/>
                <bpmndi:BPMNLabel><dc:Bounds x="1512" y="225" width="84" height="27"/></bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="BPMNShape_taskProcessPayment" bpmnElement="taskProcessPayment">
                <dc:Bounds x="1622" y="160" width="100" height="80"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="BPMNShape_taskCreateCertificate" bpmnElement="taskCreateCertificate">
                <dc:Bounds x="1772" y="160" width="100" height="80"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="BPMNShape_sendVGMPurchased" bpmnElement="sendVGMPurchased">
                <dc:Bounds x="1922" y="160" width="100" height="80"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="BPMNShape_notifyShipperVGMPurchased" bpmnElement="notifyShipperVGMPurchased">
                <dc:Bounds x="2072" y="160" width="100" height="80"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="BPMNShape_endEvent" bpmnElement="endEvent">
                <dc:Bounds x="2222" y="182" width="36" height="36"/>
                <bpmndi:BPMNLabel><dc:Bounds x="2200" y="225" width="80" height="14"/></bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNEdge id="BPMNEdge_flow0" bpmnElement="flow0">
                <di:waypoint x="136" y="200"/><di:waypoint x="186" y="200"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flow1" bpmnElement="flow1">
                <di:waypoint x="286" y="200"/><di:waypoint x="336" y="200"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flow2" bpmnElement="flow2">
                <di:waypoint x="436" y="200"/><di:waypoint x="486" y="200"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flow2b" bpmnElement="flow2b">
                <di:waypoint x="586" y="200"/><di:waypoint x="636" y="200"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flow3" bpmnElement="flow3">
                <di:waypoint x="736" y="200"/><di:waypoint x="786" y="200"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flow4" bpmnElement="flow4">
                <di:waypoint x="886" y="200"/><di:waypoint x="936" y="200"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flow4b" bpmnElement="flow4b">
                <di:waypoint x="1036" y="200"/><di:waypoint x="1086" y="200"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flow5" bpmnElement="flow5">
                <di:waypoint x="1186" y="200"/><di:waypoint x="1236" y="200"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flow6" bpmnElement="flow6">
                <di:waypoint x="1336" y="200"/><di:waypoint x="1386" y="200"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flow6b" bpmnElement="flow6b">
                <di:waypoint x="1486" y="200"/><di:waypoint x="1536" y="200"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flow7" bpmnElement="flow7">
                <di:waypoint x="1572" y="200"/><di:waypoint x="1622" y="200"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flow8" bpmnElement="flow8">
                <di:waypoint x="1722" y="200"/><di:waypoint x="1772" y="200"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flow9" bpmnElement="flow9">
                <di:waypoint x="1872" y="200"/><di:waypoint x="1922" y="200"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flow10" bpmnElement="flow10">
                <di:waypoint x="2022" y="200"/><di:waypoint x="2072" y="200"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flow11" bpmnElement="flow11">
                <di:waypoint x="2172" y="200"/><di:waypoint x="2222" y="200"/>
            </bpmndi:BPMNEdge>

        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>

</definitions>
