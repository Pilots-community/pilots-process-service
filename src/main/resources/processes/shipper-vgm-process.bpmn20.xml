<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shipper VGM Process  (consumer / shipper)
  Process ID: shipperProcess

  Flow:
    Start
      -> ReceiveTask  "Wait for Order Created"      PATCH by Certiweight (via EDC) after order is placed
      -> ReceiveTask  "Wait for Trucker Announced"  PATCH by Certiweight (via EDC) when trucker arrives
      -> ReceiveTask  "Wait for Measurement Created" PATCH by Certiweight (via EDC) with weight data
                                                    PATCH must also set internalApiUrl for sendPurchaseVGM
      -> ServiceTask  "Send Purchase VGM"            calls internalApiUrl (set by previous PATCH)
      -> ReceiveTask  "Wait for VGM Purchased"       PATCH by Certiweight (via EDC) with certificate ref
      -> ServiceTask  "Download Certificate"         no-op placeholder (replace with real download delegate)
    End

  This process instance must be created BEFORE or ALONGSIDE Certiweight's instance so that
  Certiweight can PATCH it when each notification is ready.

  Required process variables at start (POST parameters):
    internalApiUrl  - URL to notify when Shipper needs to confirm purchase
                      (set by Certiweight's PATCH of waitMeasurementCreated, not at start time)

  The first two ReceiveTasks do not need internalApiUrl because they are pure wait states.
  The PATCH that triggers waitMeasurementCreated must include:
    internalApiUrl  - URL for sendPurchaseVGM (e.g. http://shipper-tms/purchase-vgm)
    payloadData     - measurement data / weight
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="https://example.com/lod/shipper">

    <process id="shipperProcess"
             name="Shipper VGM Process"
             isExecutable="true">

        <startEvent id="startEvent" name="Start"/>
        <sequenceFlow id="flow1" sourceRef="startEvent" targetRef="waitOrderCreated"/>

        <!-- Pauses immediately after start. PATCH by Certiweight (via EDC) when order is confirmed. -->
        <receiveTask id="waitOrderCreated" name="Wait for Order Created"/>
        <sequenceFlow id="flow2" sourceRef="waitOrderCreated" targetRef="waitTruckerAnnounced"/>

        <!-- Pauses here. PATCH by Certiweight (via EDC) when trucker arrives at facility. -->
        <receiveTask id="waitTruckerAnnounced" name="Wait for Trucker Announced"/>
        <sequenceFlow id="flowTA" sourceRef="waitTruckerAnnounced" targetRef="waitMeasurementCreated"/>

        <!-- Pauses here. PATCH by Certiweight (via EDC) when weight is measured.
             This PATCH must include internalApiUrl + payloadData for sendPurchaseVGM. -->
        <receiveTask id="waitMeasurementCreated" name="Wait for Measurement Created"/>
        <sequenceFlow id="flow3" sourceRef="waitMeasurementCreated" targetRef="sendPurchaseVGM"/>

        <serviceTask id="sendPurchaseVGM"
                     name="Send Purchase VGM"
                     flowable:delegateExpression="${invokeInternalApiDelegate}"/>
        <sequenceFlow id="flow4" sourceRef="sendPurchaseVGM" targetRef="waitVGMPurchased"/>

        <!-- Pauses here. PATCH by Certiweight (via EDC) when certificate is ready. -->
        <receiveTask id="waitVGMPurchased" name="Wait for VGM Purchased"/>
        <sequenceFlow id="flow5" sourceRef="waitVGMPurchased" targetRef="taskDownloadCertificate"/>

        <!-- Placeholder: replace flowable:expression with a real download delegate when ready. -->
        <serviceTask id="taskDownloadCertificate"
                     name="Download Certificate"
                     flowable:expression="${true}"/>
        <sequenceFlow id="flow6" sourceRef="taskDownloadCertificate" targetRef="endEvent"/>

        <endEvent id="endEvent" name="Done"/>

    </process>
</definitions>
