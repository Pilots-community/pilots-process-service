<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shipper VGM Process  (consumer / shipper)
  Process ID: shipperProcess

  Flow:
    Start
      -> IntermediateCatchEvent  "Wait for Order Created"       PATCH by Certiweight (via EDC)
      -> IntermediateCatchEvent  "Wait for Trucker Announced"   PATCH by Certiweight (via EDC)
      -> IntermediateCatchEvent  "Wait for Measurement Created" PATCH by Certiweight (via EDC)
                                                                PATCH must also set internalApiUrl for sendPurchaseVGM
      -> ServiceTask             "Send Purchase VGM"            calls internalApiUrl (set by previous PATCH)
      -> IntermediateCatchEvent  "Wait for VGM Purchased"       PATCH by Certiweight (via EDC)
    End
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="https://example.com/lod/shipper">

    <message id="msgOrderCreated"       name="OrderCreated"/>
    <message id="msgTruckerAnnounced"   name="TruckerAnnounced"/>
    <message id="msgMeasurementCreated" name="MeasurementCreated"/>
    <message id="msgVGMPurchased"       name="VGMPurchased"/>

    <process id="shipperProcess"
             name="Shipper VGM Process"
             isExecutable="true">

        <startEvent id="startEvent" name="Start"/>
        <sequenceFlow id="flow1" sourceRef="startEvent" targetRef="waitOrderCreated"/>

        <intermediateCatchEvent id="waitOrderCreated" name="Wait for Order Created">
            <messageEventDefinition messageRef="msgOrderCreated"/>
        </intermediateCatchEvent>
        <sequenceFlow id="flow2" sourceRef="waitOrderCreated" targetRef="waitTruckerAnnounced"/>

        <intermediateCatchEvent id="waitTruckerAnnounced" name="Wait for Trucker Announced">
            <messageEventDefinition messageRef="msgTruckerAnnounced"/>
        </intermediateCatchEvent>
        <sequenceFlow id="flowTA" sourceRef="waitTruckerAnnounced" targetRef="waitMeasurementCreated"/>

        <!-- PATCH triggering this must include internalApiUrl + payloadData for sendPurchaseVGM. -->
        <intermediateCatchEvent id="waitMeasurementCreated" name="Wait for Measurement Created">
            <messageEventDefinition messageRef="msgMeasurementCreated"/>
        </intermediateCatchEvent>
        <sequenceFlow id="flow3" sourceRef="waitMeasurementCreated" targetRef="sendPurchaseVGM"/>

        <serviceTask id="sendPurchaseVGM"
                     name="Send Purchase VGM"
                     flowable:delegateExpression="${invokeInternalApiDelegate}"/>
        <sequenceFlow id="flow4" sourceRef="sendPurchaseVGM" targetRef="waitVGMPurchased"/>

        <intermediateCatchEvent id="waitVGMPurchased" name="Wait for VGM Purchased">
            <messageEventDefinition messageRef="msgVGMPurchased"/>
        </intermediateCatchEvent>
        <sequenceFlow id="flow5" sourceRef="waitVGMPurchased" targetRef="endEvent"/>

        <endEvent id="endEvent" name="Done"/>

    </process>

    <bpmndi:BPMNDiagram id="BPMNDiagram_shipperProcess">
        <bpmndi:BPMNPlane id="BPMNPlane_shipperProcess" bpmnElement="shipperProcess">
            <!-- startEvent: center (150, 200) -->
            <bpmndi:BPMNShape id="BPMNShape_startEvent" bpmnElement="startEvent">
                <dc:Bounds x="132" y="182" width="36" height="36"/>
                <bpmndi:BPMNLabel><dc:Bounds x="138" y="225" width="24" height="14"/></bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>
            <!-- waitOrderCreated: center (260, 200) -->
            <bpmndi:BPMNShape id="BPMNShape_waitOrderCreated" bpmnElement="waitOrderCreated">
                <dc:Bounds x="242" y="182" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <!-- waitTruckerAnnounced: center (380, 200) -->
            <bpmndi:BPMNShape id="BPMNShape_waitTruckerAnnounced" bpmnElement="waitTruckerAnnounced">
                <dc:Bounds x="362" y="182" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <!-- waitMeasurementCreated: center (500, 200) -->
            <bpmndi:BPMNShape id="BPMNShape_waitMeasurementCreated" bpmnElement="waitMeasurementCreated">
                <dc:Bounds x="482" y="182" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <!-- sendPurchaseVGM: center (630, 200) -->
            <bpmndi:BPMNShape id="BPMNShape_sendPurchaseVGM" bpmnElement="sendPurchaseVGM">
                <dc:Bounds x="580" y="160" width="100" height="80"/>
            </bpmndi:BPMNShape>
            <!-- waitVGMPurchased: center (780, 200) -->
            <bpmndi:BPMNShape id="BPMNShape_waitVGMPurchased" bpmnElement="waitVGMPurchased">
                <dc:Bounds x="762" y="182" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <!-- endEvent: center (880, 200) -->
            <bpmndi:BPMNShape id="BPMNShape_endEvent" bpmnElement="endEvent">
                <dc:Bounds x="862" y="182" width="36" height="36"/>
                <bpmndi:BPMNLabel><dc:Bounds x="868" y="225" width="24" height="14"/></bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNEdge id="BPMNEdge_flow1" bpmnElement="flow1">
                <di:waypoint x="168" y="200"/><di:waypoint x="242" y="200"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flow2" bpmnElement="flow2">
                <di:waypoint x="278" y="200"/><di:waypoint x="362" y="200"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowTA" bpmnElement="flowTA">
                <di:waypoint x="398" y="200"/><di:waypoint x="482" y="200"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flow3" bpmnElement="flow3">
                <di:waypoint x="518" y="200"/><di:waypoint x="580" y="200"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flow4" bpmnElement="flow4">
                <di:waypoint x="680" y="200"/><di:waypoint x="762" y="200"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flow5" bpmnElement="flow5">
                <di:waypoint x="798" y="200"/><di:waypoint x="862" y="200"/>
            </bpmndi:BPMNEdge>
        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>

</definitions>
